# ALDAPCON Platform — environment template
#
# TRD §6.4: .env is never committed. This file documents every key the
# application reads, with empty values for anything secret. Copy it to .env and
# fill it in — bin/setup.sh does that for you on a fresh clone.
#
# No env() call exists outside config/ (plan §2, rule 4). If you add a key here,
# add it to a config file too.

APP_NAME=ALDAPCON
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Schema §1.4 — stored UTC, rendered Africa/Lagos.
APP_TIMEZONE=UTC
APP_LOCALE=en

# Host port nginx binds to. Change if 8000 is taken.
APP_PORT=8000

# --- Database (TRD §2.2 — PostgreSQL 16) ---------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aldapcon
DB_USERNAME=aldapcon
DB_PASSWORD=secret
DB_PORT_HOST=5432

# --- Redis (TRD §2.3 — cache, session and queue) -------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_HOST=6379

# Sessions live in Redis, which is why there is no sessions table
# (Schema §2.1). Changing these drivers invalidates that decision.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail ------------------------------------------------------------------
# Local: Mailpit, nothing leaves the machine (TRD §9).
# Staging and production: the provider chosen in B-5, still open.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@aldapcon.test
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Paystack (TRD §2, Phase 8) -------------------------------------------
# Test keys locally and in staging, live keys in production only (TRD §9).
# The secret key is server-side only and is never exposed to a template or a
# client bundle (TRD §6.4). Empty here on purpose.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
